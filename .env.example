# Local / Compose example — copy to .env (never commit .env)
#
# Default Compose (Postgres):
DATABASE_URL=postgres://oxidean:oxidean@postgres:5432/oxidean
POSTGRES_USER=oxidean
POSTGRES_PASSWORD=oxidean
POSTGRES_DB=oxidean

# Optional; must agree with DATABASE_URL scheme when set (D-01/D-02)
# OXIDEAN_DB_DIALECT=postgres

# Auto-migrate on API boot (default true). Prod-like: set false and run `make db-migrate`.
OXIDEAN_AUTO_MIGRATE=true

# Compose CORS must allowlist Traefik public origin (D-20)
OXIDEAN_ENV=compose
OXIDEAN_CORS_ORIGINS=http://localhost,http://127.0.0.1
API_BIND=0.0.0.0:8080
OXIDEAN_RPC_VERSION=1

# Bare git repos root (D-30 / D-31). Default var/repos; Compose bind ./var/repos:/var/repos
# (api CWD is `/` so relative default resolves to /var/repos). Requires system git ≥ 2.5 (D-33).
# OXIDEAN_REPOS_DIR=var/repos
# Days to keep rename/transfer redirects (default 90). Purged by orphan reconcile.
# OXIDEAN_REPO_REDIRECT_RETENTION_DAYS=90
# Release assets volume (distinct from LFS). Default var/release-assets; Compose binds ./var/release-assets.
# OXIDEAN_RELEASE_ASSETS_DIR=var/release-assets
# OXIDEAN_RELEASE_ASSET_MAX_BYTES=536870912

# Git LFS object store (D-LFS-01 / GIT-13). Default var/lfs; Compose bind ./var/lfs:/var/lfs
# and sets OXIDEAN_LFS_DIR=/var/lfs (api CWD is `/`).
# OXIDEAN_LFS_DIR=var/lfs
# Optional quota defaults (Admin UI can override; 0 disables that limit):
# OXIDEAN_LFS_MAX_OBJECT_BYTES=2147483648
# OXIDEAN_LFS_QUOTA_REPO_BYTES=10737418240
# OXIDEAN_LFS_QUOTA_USER_BYTES=53687091200
# GC job (default 24h interval, 7d grace after refcount=0; set interval 0 to disable):
# OXIDEAN_LFS_GC_INTERVAL_SECS=86400
# OXIDEAN_LFS_GC_GRACE_SECS=604800

# Package registry blob store (D-PKG-07). Distinct from OXIDEAN_REPOS_DIR / LFS / release-assets.
# Compose binds ./var/packages:/var/packages and sets OXIDEAN_PACKAGES_DIR=/var/packages.
# OXIDEAN_PACKAGES_DIR=var/packages
# Max single blob size (default 2 GiB) and per-owner quota (default 10 GiB) — enforced by later plans.
# OXIDEAN_PACKAGES_MAX_BLOB_BYTES=2147483648
# OXIDEAN_PACKAGES_OWNER_QUOTA_BYTES=10737418240

# Instance template packs (issue #18). Content-addressed zips; Compose binds ./var/template-packs.
# OXIDEAN_TEMPLATE_PACKS_DIR=var/template-packs
# OXIDEAN_TEMPLATE_PACK_MAX_BYTES=10485760

# Actions (Phase 19). Secrets encrypt fail closed without a key (D-ACT-17).
# Compose defaults OXIDEAN_ACTIONS_SECRETS_KEY to a local-only value; override for real deploys.
# OXIDEAN_ACTIONS_ENABLED=true
# MCP endpoint (AGT-01/AGT-03). Enabled by default; Admin → MCP endpoint can override at runtime.
# OXIDEAN_MCP_ENABLED=true
# OXIDEAN_ACTIONS_LOG_DIR=var/actions-logs
OXIDEAN_ACTIONS_SECRETS_KEY=compose-dev-actions-secrets-key-not-for-production
# OXIDEAN_RUNNER_REGISTRATION_TOKEN=  # Compose profile `actions` bootstrap ONLY — reusable while set; unset on any internet-facing API; never commit real values

# In-repo search soft caps (GIT-18 / D-SRCH-08). Defaults: 8000ms / 100 matches / 50 files.
# OXIDEAN_SEARCH_TIMEOUT_MS=8000
# OXIDEAN_SEARCH_MAX_MATCHES=100
# OXIDEAN_SEARCH_MAX_FILES=50

# Local make-dev (Vite on :3000 talking to API on :8080):
# OXIDEAN_ENV=development
# OXIDEAN_CORS_ORIGINS=http://localhost:3000
# DATABASE_URL=postgres://oxidean:oxidean@localhost:5432/oxidean

# SQLite (no Compose DB service — D-07 / D-17):
# DATABASE_URL=sqlite:./var/oxidean.db

# MySQL profile (see docker-compose.mysql.yml / `make up-mysql`):
# DATABASE_URL=mysql://oxidean:oxidean@mysql:3306/oxidean

# Optional first sys-admin when users table is empty (set before first boot).
# Empty-instance path: ENV seed (both set) OR interactive /setup when either/both unset.
# Seeded username is system-administrator; first visit forces /setup/credentials.
# OXIDEAN_ADMIN_EMAIL=admin@example.com
# OXIDEAN_ADMIN_PASSWORD=change-me-now
# Local signup after bootstrap (true/1 opens; default false — fail closed).
# Cloud deploys that want open signup should set true.
# OXIDEAN_ALLOW_SIGNUP=false

# Outbound email (Resend → SMTP → log sink). Secrets ENV-only (D-09); from address optional.
# OXIDEAN_RESEND_API_KEY=
# OXIDEAN_RESEND_BASE_URL=          # optional local stub base (docs/dev-auth.md)
# OXIDEAN_SMTP_URL=smtp://localhost:1025
# OXIDEAN_MAIL_FROM="Oxidean <noreply@localhost>"

# WorkOS (enterprise SSO) — used when provider mode is workos:
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# OXIDEAN_WORKOS_BASE_URL=          # optional local stub (docs/dev-auth.md)
# OXIDEAN_WORKOS_AUTHORIZE_BASE_URL=

# Generic OIDC — used when provider mode is oidc:
# OXIDEAN_OIDC_ISSUER=
# OXIDEAN_OIDC_CLIENT_ID=
# OXIDEAN_OIDC_CLIENT_SECRET=
# OXIDEAN_OIDC_ALLOW_INSECURE=1     # local mocks only; requires OXIDEAN_ENV=development|dev|compose

# Public origin for magic links (verify/reset) and SSO callback redirect URIs.
# Compose / Traefik (`make up`): http://localhost
# Host Vite (`make dev`): http://localhost:3000
# OXIDEAN_PUBLIC_ORIGIN=http://localhost
# Compose override (wins inside API container even if OXIDEAN_PUBLIC_ORIGIN is set for host):
# OXIDEAN_COMPOSE_PUBLIC_ORIGIN=http://localhost

# Git-over-SSH (Compose publishes TCP 2222 on api — not Traefik). Clone URL is always
# scp-style: git@{OXIDEAN_SSH_HOST}:{owner}/{repo}.git
# When OXIDEAN_SSH_PORT ≠ 22, clients need ~/.ssh/config Port (or ssh -p); do not use ssh:// as primary.
# OXIDEAN_SSH_ENABLED=true
# OXIDEAN_SSH_PORT=2222
# OXIDEAN_SSH_HOST=localhost
# OXIDEAN_SSH_HOST_KEY_DIR=/var/ssh
# Host `make dev` omits the SSH listener unless OXIDEAN_SSH_ENABLED is set explicitly.

# Outbound webhooks (Phase 18 / HOOK-02/03)
# OXIDEAN_WEBHOOK_MAX_ATTEMPTS=5
# OXIDEAN_WEBHOOK_TIMEOUT_SECS=10
# OXIDEAN_WEBHOOK_WORKER_INTERVAL_SECS=5
# OXIDEAN_WEBHOOK_RETENTION_DAYS=30

# Local stubs without cloud secrets — see docs/dev-auth.md
# Host API: make up-dev-auth + docs/dev-auth.env.example
# Compose API + Mailpit: make up-with-dev-auth (docs/dev-auth.env.compose.example)

# ---------------------------------------------------------------------------
# Oxidean Cloud (Railway-class) — set in the Railway dashboard, not in git.
# See docs/DEPLOYMENT.md and .railway/railway.ts (D-CLOUD-06).
# ---------------------------------------------------------------------------
# OXIDEAN_ENV=production
# OXIDEAN_DB_DIALECT=postgres
# OXIDEAN_AUTO_MIGRATE=false
# OXIDEAN_ALLOW_SIGNUP=true
# OXIDEAN_PUBLIC_ORIGIN=https://your-cloud-domain.example
# OXIDEAN_CORS_ORIGINS=https://your-cloud-domain.example
# DATABASE_URL=  # from Railway Postgres plugin
# Forge volume paths (api mounts forge-data at /var):
# OXIDEAN_REPOS_DIR=/var/repos
# OXIDEAN_LFS_DIR=/var/lfs
# OXIDEAN_PACKAGES_DIR=/var/packages
# OXIDEAN_RELEASE_ASSETS_DIR=/var/release-assets
# OXIDEAN_SSH_HOST_KEY_DIR=/var/ssh
# OXIDEAN_SSH_ENABLED=true
# OXIDEAN_SSH_PORT=2222
# OXIDEAN_SSH_HOST=your-cloud-domain.example
# Web-flow commit-signing key (signs seeded initial commits). Auto-generated on
# first use everywhere except production/cloud, which require this var or a
# provisioned keypair under OXIDEAN_SSH_HOST_KEY_DIR.
# OXIDEAN_WEB_FLOW_PRIVATE_KEY=  # OpenSSH PEM or base64 PEM — never commit a real key
