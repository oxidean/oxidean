# Oxidean Cloud gateway — Caddyfile
#
# File-configured reverse proxy (D-CLOUD-03). Mirrors Compose Traefik path
# priorities without a Docker socket. Public Host is catch-all (Railway TLS /
# custom domain); do not require Host(localhost).
#
# Upstream hosts come from Railway private networking (set via env on the
# gateway service). Defaults match service names on the private network.

{
	# Railway terminates TLS at the edge; listen on the assigned PORT.
	auto_https off
}

:{$PORT:8080} {
	encode gzip

	# Priority ≈ Traefik 110 — Smart HTTP git
	@git path_regexp git ^/[^/]+/[^/]+\.git
	handle @git {
		reverse_proxy {$API_HOST:api.railway.internal}:{$API_PORT:8080}
	}

	# Priority ≈ Traefik 110 — package registries
	@packages path /v2/* /npm/* /generic/* /v2 /npm /generic
	handle @packages {
		reverse_proxy {$API_HOST:api.railway.internal}:{$API_PORT:8080}
	}

	# Priority ≈ Traefik 110 — CLI install script + binaries
	@cli path /cli/* /cli
	handle @cli {
		reverse_proxy {$API_HOST:api.railway.internal}:{$API_PORT:8080}
	}

	# Priority ≈ Traefik 100 — API surface. The two OAuth discovery docs are
	# named literally (plus /* for RFC 9728 path-suffixed resource variants) so
	# /.well-known/acme-challenge/* stays on the web tier.
	@api path /api/* /uploads/* /health /api /uploads /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @api {
		reverse_proxy {$API_HOST:api.railway.internal}:{$API_PORT:8080}
	}

	# Priority ≈ Traefik 1 — SPA / web
	handle {
		reverse_proxy {$WEB_HOST:web.railway.internal}:{$WEB_PORT:3000}
	}
}
