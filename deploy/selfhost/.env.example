# ============================================================================
# Oxidean self-host — environment template. Copy to .env (never commit .env).
# Generate the two required secrets, then `docker compose up -d`.
# Full guide: ../../docs/SELF-HOSTING.md — env reference: ../../docs/CONFIGURATION.md
# ============================================================================

# --- Required secrets (no safe defaults) -------------------------------------
# Database password for the bundled postgres — interpolated into DATABASE_URL,
# so keep it URL-safe (no `/`). Recommended generation emits hex only:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# Encrypts Actions/mirror/webhook secrets and TOTP at rest (AES-256-GCM).
# Rotating invalidates stored ciphertexts. NEVER reuse the dev-compose value.
#   openssl rand -base64 32
OXIDEAN_ACTIONS_SECRETS_KEY=

# --- Identity ----------------------------------------------------------------
# Image tag for ghcr.io/oxidean/oxidean-{api,web,runner}.
# `latest` tracks the newest stable; pin a semver tag for production.
OXIDEAN_VERSION=latest
# Public DNS name — used by the `tls` profile (Caddyfile) for auto-HTTPS.
DOMAIN=git.example.com
# Browser-facing origin: magic links, SSO redirects, HTTPS clone URLs.
# TLS install → https://$DOMAIN. Local eval → http://localhost:8080.
OXIDEAN_PUBLIC_ORIGIN=http://localhost:8080
# Browser origins allowed cross-origin (comma-separated).
# Optional — defaults to OXIDEAN_PUBLIC_ORIGIN, which is correct for the
# single-origin layout this stack uses.
# OXIDEAN_CORS_ORIGINS=
# `production` = Secure session cookies + fail-closed prod gates (requires
# HTTPS, or http://localhost which browsers treat as trustworthy).
# Plain-HTTP LAN install (http://192.168.x.y): use `development` instead —
# and read the trade-offs in docs/SELF-HOSTING.md before you do.
OXIDEAN_ENV=production

# --- Web-flow commit signing --------------------------------------------------
# Seed commits (template/stack/license initial commits) are SSH-signed with
# this key. REQUIRED when OXIDEAN_ENV=production — the first repo created
# through the UI fails without it. Provision once:
#   ssh-keygen -t ed25519 -N '' -f web-flow && base64 -w0 web-flow
# Paste the single-line output below (or drop web-flow + web-flow.pub into
# the ssh/ dir of the oxidean_data volume). Auto-generated for development.
# OXIDEAN_WEB_FLOW_PRIVATE_KEY=

# --- Database -----------------------------------------------------------------
POSTGRES_USER=oxidean
POSTGRES_DB=oxidean
# Defaults to the bundled postgres (credentials auto-derived above). For an
# external DB set the URL (percent-encode any reserved chars in credentials)
# and remove the postgres service + depends_on:
#   postgres://user:pass@host:5432/db · mysql://user:pass@host:3306/db
#   sqlite:/var/oxidean.db  (file lives inside the oxidean_data volume)
# DATABASE_URL=

# --- Git over SSH -------------------------------------------------------------
# Raw TCP endpoint for git clone/push over SSH (not routed through caddy).
# Advertised host/port feed the UI's CloneBox URLs; when the port is not 22,
# users need `Port` in ~/.ssh/config.
OXIDEAN_SSH_ENABLED=true
OXIDEAN_SSH_PORT=2222
OXIDEAN_SSH_HOST=localhost

# --- Web edge -----------------------------------------------------------------
# Where the web tier is published. Loopback default expects the `tls`
# profile (or your own edge) in front. LAN/HTTP-only: 0.0.0.0:8080 — and set
# OXIDEAN_WEB_BEHIND_PROXY empty so the tier sanitizes X-Forwarded-* itself.
OXIDEAN_HTTP_BIND=127.0.0.1:8080
# 1 = a sanitizing edge (bundled caddy / your proxy) sits in front and its
# forwarded headers are trusted. Empty/0 = web tier is the edge.
OXIDEAN_WEB_BEHIND_PROXY=1

# --- First boot / accounts ----------------------------------------------------
# Optional empty-instance sys-admin seed (wizard /setup does the same job
# interactively when both are unset). Username: system-administrator;
# first sign-in forces a credential change.
# OXIDEAN_ADMIN_EMAIL=
# OXIDEAN_ADMIN_PASSWORD=
# Open local signup after bootstrap (default false — fail closed).
# OXIDEAN_ALLOW_SIGNUP=false

# --- Outbound mail -------------------------------------------------------------
# Verify/reset links, invites. Resend wins over SMTP; neither → log sink
# (invite URLs are still shown once in the UI).
# OXIDEAN_RESEND_API_KEY=
# OXIDEAN_SMTP_URL=smtp://host:25
# OXIDEAN_MAIL_FROM="Oxidean <noreply@example.com>"

# --- SSO (optional) ------------------------------------------------------------
# OXIDEAN_OIDC_ISSUER=
# OXIDEAN_OIDC_CLIENT_ID=
# OXIDEAN_OIDC_CLIENT_SECRET=
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# --- Actions runner (profile `actions`) ----------------------------------------
# API+clone base the runner uses — compose-internal by default.
# OXIDEAN_RUNNER_ORIGIN=http://api:8080
# Bootstrap token — reusable while set; prefer one-time DB-minted tokens on
# internet-facing instances. Must match the api-side value.
# OXIDEAN_RUNNER_REGISTRATION_TOKEN=
# OXIDEAN_RUNNER_NAME=selfhost-runner
# OXIDEAN_RUNNER_LABELS=ubuntu-latest,self-hosted
# PAT for cloning private repos on the runner.
# OXIDEAN_RUNNER_GIT_TOKEN=

# --- Misc ---------------------------------------------------------------------
# OXIDEAN_ENV aside, these rarely need changing — see docs/CONFIGURATION.md.
# OXIDEAN_ACTIONS_ENABLED=true
# OXIDEAN_MCP_ENABLED=true
# OXIDEAN_AUTO_MIGRATE=true
# OXIDEAN_SECRETS_KEY=      # dedicated TOTP key (falls back to ACTIONS_SECRETS_KEY)
# RUST_LOG=info
