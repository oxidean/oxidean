   "id": "reusable-workflow-local",
   "kind": "run",
   "files": {
    ".github/workflows/reusable.yml": "name: reusable-callee\non:\n  workflow_call:\n    inputs:\n      env:\n        required: true\n        type: string\n        default: local\n    secrets:\n      CALLEE_KEY:\n        required: false\n    outputs:\n      result:\n        value: ${{ jobs.build.outputs.r }}\njobs:\n  build:\n    runs-on: ubuntu-latest\n    outputs:\n      r: ${{ steps.s.outputs.r }}\n    steps:\n      - id: s\n        run: |\n          echo \"env=${{ inputs.env }}\"\n          echo \"callee_secret=${{ secrets.CALLEE_KEY }}end\"\n          echo \"caller_secret=${{ secrets.CONFORMANCE_SECRET }}end\"\n          echo \"r=ok-${{ inputs.env }}\" >> \"$GITHUB_OUTPUT\"\n"
   },
   "expect_jobs": {
    "call": "success",
    "build": "success",
    "report": "success"
   },
   "log_contains": [
    "env=prod",
    "call result=ok-prod"
   ]
  },
