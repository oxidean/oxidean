{
  "version": 1,
  "docs": "GitHub Actions conformance corpus. kinds: run (dispatch + scripted runner executes, assert run/job status + job logs), validation_failure (a run is created with a single failed __validation job naming the unsupported features — the loud-failure contract), queued (jobs stay queued — no matching runner labels), never_dispatch (no run is created for this trigger/input). Cases expecting real execution of features still marked unsupported are asserted as validation_failure today and flip to run as phases land.",
  "cases": [
    {
      "id": "run-basic",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["hello conformance"]
    },
    {
      "id": "run-fail",
      "kind": "run",
      "expect_run": "failure",
      "expect_jobs": {"build": "failure"}
    },
    {
      "id": "run-multi-step",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["one", "two", "three", "##[step]first", "##[step]third"]
    },
    {
      "id": "run-env-step",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["marker=step-env-value"]
    },
    {
      "id": "run-env-multiline",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["line one", "line two"]
    },
    {
      "id": "run-workdir",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["/sub"]
    },
    {
      "id": "run-workdir-missing",
      "kind": "run",
      "expect_run": "failure",
      "expect_jobs": {"build": "failure"}
    },
    {
      "id": "run-shell-sh",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["shell is"]
    },
    {
      "id": "run-defaults-shell",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["default shell applied"]
    },
    {
      "id": "run-defaults-workdir",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["/sub"]
    },
    {
      "id": "checkout-basic",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["post-checkout"]
    },
    {
      "id": "checkout-with-inputs",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["::warning::with (step inputs are not applied yet)", "done"]
    },
    {
      "id": "uses-unknown",
      "kind": "run",
      "expect_run": "failure",
      "expect_jobs": {"build": "failure"},
      "log_contains": ["unsupported action", "actions/setup-node"]
    },
    {
      "id": "multi-job-parallel",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success", "test": "success"},
      "log_contains": ["from build", "from test"]
    },
    {
      "id": "job-name-override",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "expect_job_names": {"build": "Fancy Build Job"}
    },
    {
      "id": "exit-code-nonzero",
      "kind": "run",
      "expect_run": "failure",
      "expect_jobs": {"build": "failure"}
    },
    {
      "id": "echo-unicode",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["héllo wörld ünïcode"]
    },
    {
      "id": "runs-on-array",
      "kind": "run",
      "runner_labels": ["self-hosted", "linux"],
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["array labels"]
    },
    {
      "id": "runs-on-nomatch",
      "kind": "queued",
      "runner_labels": ["ubuntu-latest"],
      "expect_jobs": {"build": "queued"}
    },
    {
      "id": "secrets-mask",
      "kind": "run",
      "secrets": {"CONFORMANCE_SECRET": "hunter2-do-not-print"},
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["token is ***"],
      "log_absent": ["hunter2-do-not-print"]
    },
    {
      "id": "secrets-env",
      "kind": "run",
      "secrets": {"CONFORMANCE_SECRET": "hunter2-do-not-print"},
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["secret present"],
      "log_absent": ["hunter2-do-not-print"]
    },
    {
      "id": "expr-in-run",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["::warning::${{ }} expressions are not evaluated"]
    },
    {
      "id": "workflow-env",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["::warning::env (workflow env is not applied yet)"]
    },
    {
      "id": "job-env",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["::warning::env (job env is not applied yet)"]
    },
    {
      "id": "push-tag-ref",
      "kind": "run",
      "head_ref": "refs/tags/v1.0.0",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["ref is refs/tags/v1.0.0"]
    },
    {
      "id": "trigger-map-form",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["map form"]
    },
    {
      "id": "trigger-list-form",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {"build": "success"},
      "log_contains": ["list form"]
    },
    {
      "id": "dispatch-only",
      "kind": "never_dispatch",
      "note": "workflow_dispatch alone does not fire on push"
    },
    {
      "id": "pr-only",
      "kind": "never_dispatch",
      "note": "pull_request fires via the PR path, not push dispatch"
    },
    {
      "id": "prt-only",
      "kind": "never_dispatch",
      "note": "pull_request_target is flagged unsupported and never fires; a push-only workflow containing it would validation-fail instead"
    },
    {
      "id": "runs-on-missing",
      "kind": "never_dispatch",
      "note": "ParseError — lands in discovered.errors today (lossy; Phase 8 persists these as failed validation jobs)"
    },
    {
      "id": "needs-basic",
      "kind": "validation_failure",
      "expect_unsupported": ["needs"]
    },
    {
