{
  "version": 1,
  "docs": "GitHub Actions conformance corpus. kinds: run (dispatch + scripted runner executes, assert run/job status + job logs), validation_failure (a run is created with a single failed __validation job naming the unsupported features \u2014 the loud-failure contract), queued (jobs stay queued \u2014 no matching runner labels), never_dispatch (no run is created for this trigger/input). Cases expecting real execution of features still marked unsupported are asserted as validation_failure today and flip to run as phases land.",
  "cases": [
    {
      "id": "run-basic",
      "kind": "run",
      "expect_run": "success",
      "expect_jobs": {
        "build": "success"
      },
      "log_contains": [
        "hello conformance"
      ]
    },
