---
const title = "Astro";
---

<div class="welcome">
  <h1>Welcome to {title}</h1>
  <p>
    To get started, open the <code>src/pages</code> directory in your project.
  </p>
  <ul>
    <li><a href="https://docs.astro.build/">Documentation</a></li>
    <li><a href="https://astro.build/themes/">Themes</a></li>
  </ul>
</div>

<style>
  .welcome {
    font-family: system-ui, sans-serif;
    max-width: 40rem;
    margin: 4rem auto;
    padding: 0 1rem;
  }
  code {
    background: #f4f4f5;
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
</style>
