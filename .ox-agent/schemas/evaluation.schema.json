{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/evaluation.schema.json",
  "type": "object",
  "required": ["schema_version", "skill", "cases", "thresholds"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string" },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "prompt", "expected"], "properties": { "id": { "type": "string" }, "prompt": { "type": "string" }, "expected": { "type": "object" } }, "additionalProperties": true } },
    "thresholds": { "type": "object", "required": ["schema_pass_rate", "quality_pass_rate"], "properties": { "schema_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }, "quality_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": true }
  },
  "additionalProperties": true
}
