{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/packet.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "created_at",
    "work_item_id",
    "skill",
    "stage",
    "context",
    "constraints",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "type": "string",
      "pattern": "^pkt_"
    },
    "created_at": {
      "type": "string"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^WI-[0-9]{4,}$"
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "skill_dir": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "required": [
        "project"
      ],
      "properties": {
        "project": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "test_command": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prior_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skill": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "token_budget": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_fix_cycles": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": [
        "schema",
        "path"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
