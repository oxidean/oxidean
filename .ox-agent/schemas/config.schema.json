{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/config.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "workflow",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "test_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "required": [
        "default_profile",
        "profiles"
      ],
      "properties": {
        "default_profile": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "additionalProperties": true
    },
    "skills": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage_skills": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
