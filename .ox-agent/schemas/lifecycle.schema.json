{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/lifecycle.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "states"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Source state name, or \"*\" for any non-archived state (shipped cannot enter blocked)."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "*"
            },
            "description": "Target state name. Edges leaving \"blocked\" use the symbolic \"blocked_from\" to return to the recorded origin state; wildcard targets are not permitted."
          },
          "gate": {
            "type": "string",
            "enum": [
              "human"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
