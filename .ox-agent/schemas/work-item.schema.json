{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/work-item.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "state",
    "profile",
    "current_stage",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^WI-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "current_stage": {
      "type": "string",
      "minLength": 1
    },
    "blocked_from": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
