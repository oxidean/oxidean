{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/discussion.schema.json",
  "type": "object",
  "required": ["schema_version", "thread_id", "summary_version", "status", "source_hash", "summarized_messages"],
  "properties": {
    "schema_version": { "const": 1 },
    "thread_id": { "type": "string", "minLength": 1 },
    "summary_version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["active", "resolved", "blocked", "archived"] },
    "source_hash": { "type": "string", "pattern": "^sha256:" },
    "summarized_messages": { "type": "array", "items": { "type": "string" } },
    "conclusion": { "type": "string" },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
