{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/remote-skills-lock.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "source",
          "sha",
          "installed_at",
          "files"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "sha": {
            "type": "string",
            "minLength": 7
          },
          "installed_at": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
