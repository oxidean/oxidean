{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/event.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "type",
    "actor"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9]+_[0-9a-f]+$"
    },
    "timestamp": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "work_item_id": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
