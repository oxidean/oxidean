{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/input-request.schema.json",
  "type": "object",
  "required": ["schema_version", "request_id", "kind", "question", "status", "created_by", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^IN-[0-9]+$" },
    "work_item_id": { "type": "string" },
    "run_id": { "type": "string" },
    "kind": { "enum": ["approval", "clarification", "decision"] },
    "question": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2 },
    "action": {
      "type": "object",
      "required": ["type", "work_item_id", "target"],
      "properties": {
        "type": { "enum": ["transition", "archive"] },
        "work_item_id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["pending", "answered", "approved", "rejected", "cancelled", "expired"] },
    "answer": { "type": "string" },
    "created_by": { "type": "string", "minLength": 1 },
    "answered_by": { "type": "string" },
    "created_at": { "type": "string" },
    "answered_at": { "type": "string" },
    "expires_at": { "type": "string" }
  },
  "additionalProperties": true
}
