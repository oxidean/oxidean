{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ox-agent.dev/schemas/framework.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "framework",
    "project"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "framework": {
      "type": "object",
      "required": [
        "name",
        "distribution",
        "binary",
        "required_version"
      ],
      "properties": {
        "name": {
          "const": "ox-agent"
        },
        "distribution": {
          "const": "standalone"
        },
        "binary": {
          "const": "ox-agent"
        },
        "required_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
