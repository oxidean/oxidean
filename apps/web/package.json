{
  "name": "@oxidean/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port ${PORT:-3000}",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project browser",
    "test:e2e:stack": "vitest run --project e2e-stack && vitest run --project e2e-stack-browser",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:coverage:unit": "vitest run --coverage --project unit --coverage.reportsDirectory=coverage/unit",
    "test:coverage:integration": "vitest run --coverage --project integration --coverage.reportsDirectory=coverage/integration",
    "lint": "oxlint --type-aware --deny-warnings . \"src/**/*.tsrx\"",
    "format": "oxfmt --write . \"src/**/*.tsrx\"",
    "format:check": "oxfmt --check . \"src/**/*.tsrx\""
  },
  "dependencies": {
    "@octanejs/astro": "0.0.40",
    "@octanejs/base-ui": "^0.1.63",
    "@octanejs/dropzone": "^0.0.28",
    "@octanejs/lucide": "^0.1.56",
    "@octanejs/recharts": "0.1.62",
    "@octanejs/tanstack-form": "^0.0.58",
    "@octanejs/tanstack-query": "^0.1.62",
    "@octanejs/zustand": "^0.1.62",
    "@oxidean/api-client": "workspace:*",
    "astro": "^7.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "2.0.1",
    "octane": "^0.10.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-github": "12.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "spdx-license-list": "6.12.0",
    "tailwind-merge": "^3.6.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@octanejs/testing-library": "^0.1.60",
    "@octanejs/vite-plugin": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@tsrx/oxc": "^0.18.0",
    "@types/pngjs": "6.0.5",
    "@vitest/browser-playwright": "^5",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.3",
    "oxlint-tsgolint": "7.0.2002",
    "pixelmatch": "7.1.0",
    "playwright": "^1.63.0",
    "pngjs": "7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5"
  }
}
