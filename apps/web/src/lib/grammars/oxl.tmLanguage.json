{
  "name": "OXL",
  "scopeName": "source.oxl",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#number"
    },
    {
      "include": "#function"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#type"
    },
    {
      "include": "#constant"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.oxl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.oxl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.oxl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.oxl",
          "match": "\\\\(u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    "char": {
      "name": "string.quoted.single.oxl",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.oxl",
          "match": "\\\\(u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.oxl",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.oxl",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keyword": {
      "name": "keyword.control.oxl",
      "match": "\\b(fn|struct|enum|interface|extern|return|if|else|for|let|scope|spawn|go|goin|spawnBlocking|chan|select|defer|match|as|import|package|break|continue)\\b"
    },
    "type": {
      "name": "storage.type.oxl",
      "match": "\\b(int|float|bool|str|byte|void|err|cstr|own|ref|mut|unsafe|nil|true|false|any|ordered|eq|add)\\b"
    },
    "function": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.oxl"
            },
            "2": {
              "name": "entity.name.function.oxl"
            }
          }
        }
      ]
    },
    "constant": {
      "name": "constant.other.oxl",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    }
  }
}
