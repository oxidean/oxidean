---
import AppShell from "@/layouts/AppShell.astro";
---

<AppShell title="Page not found · Oxidean">
  <main class="oxidean-main mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center gap-3 px-4 py-16 text-center">
    <h1 class="text-2xl font-semibold">404 — Page not found</h1>
    <p class="text-[14px] text-muted-foreground">
      The page you requested does not exist or may have moved.
    </p>
    <a href="/" class="text-[14px] text-primary underline underline-offset-4">Back to home</a>
  </main>
</AppShell>
