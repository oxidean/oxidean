---
// Canonical entry is `/{owner}/{repo}/settings/general` — the middleware
// answers a real 302; this stub is the no-JS fallback document. The hash is
// forwarded so `#repo-settings-*` legacy anchors reach the section map.
export function getStaticPaths() {
	return [{ params: { owner: "_", repo: "_" } }];
}
---

<script>
	const to = window.location.pathname.replace(
		/\/settings\/?$/,
		"/settings/general",
	);
	window.location.replace(to + window.location.search + window.location.hash);
</script>
