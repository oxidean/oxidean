---
import AppShell from "@/layouts/AppShell.astro";
import { PullDetailPage } from "@/routes/$owner.$repo.pull.$n.tsrx";

// Placeholder shell — the middleware maps every real path for this route
// onto this page; params resolve client-side from `location.pathname`.
export function getStaticPaths() {
	return [{ params: { owner: "_", repo: "_", n: "_" } }];
}
---

<AppShell title="Oxidean">
	{/* `transition:persist` — every pull sub-path shares this shell, so tab
	    clicks (/commits /checks /changes) carry the mounted island across the
	    ClientRouter swap instead of remounting (state + scroll survive). */}
	<PullDetailPage client:load transition:persist />
</AppShell>
