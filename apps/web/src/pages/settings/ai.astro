---
import AppShell from "@/layouts/AppShell.astro";
import { AiSettingsPage } from "@/routes/settings/ai.tsrx";
import { mcpHarnessSnippets } from "@/lib/mcp-harness-snippets";
import { highlightCode, languageIdForPath } from "@/lib/highlight";
import { resolvePublicOriginFromEnv } from "@/lib/public-origin";

/**
 * Pre-highlight the default MCP snippet (first harness, token mode) so the
 * first paint ships styled markup — hydration reuses it via the
 * `highlightedHtml` prop. The markup is dual-theme (`light-dark()`), correct
 * under either color scheme. The endpoint is the build placeholder;
 * oxidean-web rewrites `http://localhost` per request.
 */
const mcpEndpoint = `${resolvePublicOriginFromEnv() ?? "http://localhost"}/api/mcp`;
const defaultBlock = mcpHarnessSnippets(mcpEndpoint)[0];
let mcpInitialHtml: string | null = null;
try {
	mcpInitialHtml = await highlightCode(defaultBlock.token.code, {
		lang: languageIdForPath(defaultBlock.file),
	});
} catch {
	mcpInitialHtml = null;
}
---

<AppShell title="AI agents · Oxidean">
	<AiSettingsPage client:load mcpInitialHtml={mcpInitialHtml} />
</AppShell>
